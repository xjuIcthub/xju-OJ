# xju-OJ single-command deployment configuration.
#
# Quick start:
#   cp .env.example .env
#   # Edit domain/port/path settings below when needed.
#   ./deploy.sh
#
# On the first interactive run, deploy.sh asks for four secrets without echoing
# them and stores them as mode 0600 files outside this Git checkout. Existing
# secret files are never overwritten. Set SECRET_PROVISION_MODE=external when
# an external Secret manager provisions the *_FILE paths instead.

# Stable deployment identity. Do not change it after the first installation.
COMPOSE_PROJECT_NAME=xju-oj

# Public URL configuration. The secure default only listens on localhost.
# For a reverse proxy, keep HTTP_BIND_ADDRESS=127.0.0.1 and proxy to HTTP_PORT.
APP_DOMAIN=localhost
PUBLIC_BASE_URL=http://127.0.0.1:18080
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080

# Mutable data is kept outside the cloned repository. These defaults work for
# an unprivileged Linux user; change DEPLOY_ROOT before the first installation
# when a dedicated data disk or /srv path is preferred.
DEPLOY_ROOT=${HOME}/.local/share/xju-oj
RUNTIME_ROOT=${DEPLOY_ROOT}/runtime
BACKUP_ROOT=${DEPLOY_ROOT}/backups
SECRET_ROOT=${DEPLOY_ROOT}/secrets

# build: build the four linux/amd64 images from this checkout (quick-start default)
# pull:  consume image@sha256 references supplied below; mutable tags are rejected
DEPLOY_MODE=build

# Usually keep the Git fields blank and image references at their :auto
# sentinels. deploy.sh derives the current Git SHA, image tags, and timestamp.
# Replace the image references with immutable image@sha256 values only when
# DEPLOY_MODE=pull is used.
GIT_COMMIT=
BUILD_VERSION=phase3
BUILD_CREATED=
FRONTEND_IMAGE_REF=xju-oj-frontend:auto
BACKEND_IMAGE_REF=xju-oj-backend:auto
JUDGE_IMAGE_REF=xju-oj-server:auto
JUDGE_TOOLCHAIN_IMAGE_REF=xju-oj-judge-toolchain:auto

# Data-service images remain digest pinned in both build and pull modes.
POSTGRES_IMAGE_REF=postgres:18.6-bookworm@sha256:7d2695c3aa88e792e8b3b233e7e4adb296a20412c6c0ca361e3edaaacfada108
REDIS_IMAGE_REF=redis:8.2.8-bookworm@sha256:2f7462b9e93e0a7ae2edf3a0a0babc8a4d29f8bfc50849b906b7caaef925edc1

POSTGRES_DB=onlinejudge
POSTGRES_USER=onlinejudge
INITIAL_ADMIN_USERNAME=admin

# prompt: first run securely prompts and creates missing files once
# external: all files must already exist, be non-empty, and use mode 0400/0440/0600/0640
SECRET_PROVISION_MODE=prompt
POSTGRES_PASSWORD_FILE=${SECRET_ROOT}/postgres-password
DJANGO_SECRET_KEY_FILE=${SECRET_ROOT}/django-secret
JUDGE_SERVER_TOKEN_FILE=${SECRET_ROOT}/judge-token
INITIAL_ADMIN_PASSWORD_FILE=${SECRET_ROOT}/admin-password

# Optional targeted build and build-only proxy settings. deploy.sh deliberately
# ignores http_proxy/https_proxy/ALL_PROXY inherited from the host; only these
# explicit values may affect frontend dependency downloads, never runtime.
# Omit BUILD_TARGETS to build frontend, backend, judge-toolchain, and server.
# BUILD_TARGETS="frontend backend judge-toolchain server"
BUILD_NETWORK=default
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_ALL_PROXY=
