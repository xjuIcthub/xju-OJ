# Phase 2 isolated WSL example. Copy to .env outside Git and replace the paths with test-secret files.
COMPOSE_PROJECT_NAME=xju-oj-phase2
APP_DOMAIN=localhost
PUBLIC_BASE_URL=http://127.0.0.1:18080
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080
RUNTIME_ROOT=/tmp/xju-oj-phase2-runtime
BACKUP_ROOT=/tmp/xju-oj-phase2-backups

# Non-secret immutable image references for the WSL bridge.
FRONTEND_IMAGE_REF=xju-oj-frontend:git-7020d88
BACKEND_IMAGE_REF=xju-oj-backend:git-7020d88
JUDGE_IMAGE_REF=xju-oj-server:git-7020d88
POSTGRES_IMAGE_REF=postgres:18.6-bookworm@sha256:7d2695c3aa88e792e8b3b233e7e4adb296a20412c6c0ca361e3edaaacfada108
REDIS_IMAGE_REF=redis:8.2.8-bookworm@sha256:2f7462b9e93e0a7ae2edf3a0a0babc8a4d29f8bfc50849b906b7caaef925edc1
GIT_COMMIT=7020d88
DEPLOY_MODE=build

POSTGRES_DB=onlinejudge
POSTGRES_USER=onlinejudge
POSTGRES_PASSWORD_FILE=/tmp/xju-oj-phase2-secrets/postgres-password
DJANGO_SECRET_KEY_FILE=/tmp/xju-oj-phase2-secrets/django-secret
JUDGE_SERVER_TOKEN_FILE=/tmp/xju-oj-phase2-secrets/judge-token
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD_FILE=/tmp/xju-oj-phase2-secrets/admin-password

# Optional build-only network/proxy overrides; they are never written to images or logs.
# Leave proxy values empty to use the Docker daemon's configured build network/proxy.
# A loopback proxy requires BUILD_NETWORK=host and an actually listening host port.
BUILD_NETWORK=default
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_ALL_PROXY=
